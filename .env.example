WEBHOOK_SECRET=change_me
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Optional static token for the single-account manual ETHUSDT trading page.
# Use at least 32 random characters and expose /trade only over HTTPS.
# BINANCE_MANUAL_TOKEN=replace_with_at_least_32_random_characters
# Optional multi-account forwarding. When set, each account needs its own key pair.
# BINANCE_ACCOUNT_NAMES=primary,copy-trader
# BINANCE_PRIMARY_API_KEY=
# BINANCE_PRIMARY_API_SECRET=
# BINANCE_PRIMARY_MANUAL_TOKEN=replace_with_at_least_32_random_characters
# BINANCE_PRIMARY_ALLOWED_SYMBOLS=ETHUSDT,SOLUSDT
# BINANCE_PRIMARY_AMOUNT_MULTIPLIER=1
# BINANCE_COPY_TRADER_API_KEY=
# BINANCE_COPY_TRADER_API_SECRET=
# BINANCE_COPY_TRADER_MANUAL_TOKEN=replace_with_another_32_character_token
# BINANCE_COPY_TRADER_ALLOWED_SYMBOLS=ETHUSDT
# BINANCE_COPY_TRADER_AMOUNT_MULTIPLIER=10
BINANCE_BASE_URL=https://fapi.binance.com
ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT
ALLOW_ADD=true
DRY_RUN=true
RECV_WINDOW=5000
POSITION_POLL_SECONDS=5
POSITION_POLL_INTERVAL=0.5
BRACKET_POLL_INTERVAL=0.5
PROTECTED_RECONCILE_INTERVAL=10
ENTRY_ORDER_TIMEOUT_SECONDS=60
ALGO_WORKING_TYPE=CONTRACT_PRICE
ALGO_PRICE_PROTECT=false
SQLITE_PATH=./bridge.db
