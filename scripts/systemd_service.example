[Unit]
Description=TradingView to Binance Futures bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/tv-binance-bridge
EnvironmentFile=/home/ubuntu/tv-binance-bridge/.env
ExecStart=/home/ubuntu/tv-binance-bridge/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
